 "css": ".div {  \n    margin-left:30px;\n    margin-right:30px;\n}\n\n.content{\n    text-align: justify;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "eNote",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div style=\"font-size: 13px\">\r\n    <!--Page Head-->\r\n    <div>\r\n        <div id=\"header-html\" class=\"hidden-pdf\">\r\n            {%- if letter_head and not no_letterhead -%}\r\n                <div class=\"letter-head\">\r\n                    {{ letter_head }}\r\n                </div>\r\n            {%- endif -%}\r\n        </div>\r\n    </div>\r\n    <!-- Main Page -->\r\n    \r\n    <div class=\"div\" style=\"margin-top: -35px; font-family:bold; background-color: red;\"> \r\n        <p style=\"float:left\">{{doc.enote_format}} </p>\r\n        <p style=\"float:right\">{{frappe.utils.get_datetime(doc.note_date).strftime(\"%e-%B-%Y\",)}}</p>\r\n        \r\n    </div>\r\n    \r\n    <br/>\r\n    \r\n    \r\n    \r\n    <div class=\"div\">\r\n        <div>\r\n            <div style=\"float:left;\">\r\n                {% if doc.category==\"Notesheet\" %}\r\n                    <span>{{doc.category}}</span>\r\n                {% endif %}\r\n            </div>\r\n        </div><br>\r\n        <div class=\"content\" style=\"padding-left: 45%;\"><b><u>{{ doc.enote_category}}</u></b></div>\r\n        <div class=\"content\">{{ doc.content}}</div>\r\n        <br>\r\n    </div>\r\n    \r\n     {% set owner_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.owner}, \"scan_sign\") or \"\" %}\r\n     \r\n    <div style=\"padding-left: 30px;\">\r\n            <p style=\"font-weight: bold;\"> Thanking You:</p>\r\n            \r\n            \r\n              {% if owner_scan_sign %}\r\n            <img src=\"{{ owner_scan_sign }}\" style=\"width: 100px;\">\r\n            {% endif %}\r\n            \r\n            <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Approve\"}, \"employee_name\")}}</p>\r\n            <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Approve\"}, \"designation\")}})</p>\r\n        </div>\r\n        \r\n        \r\n    <div class=\"div\"> \r\n         {% if doc.workflow_state == \"Approved\" %}\r\n            {%- for remark in doc.remark -%}\r\n                {% if remark.action == 'Forward' and not remark.print_hide and remark.remark %}\r\n                    <span style=\"font-weight:bold;\"> Verifier Remark</span>\r\n                    <ul>\r\n                        <li>{{ remark.remark }}</li>\r\n                    </ul>\r\n                {% endif %}\r\n                \r\n                {% if remark.action == 'Approve' and not remark.print_hide and remark.remark%}\r\n                    <span style=\"font-weight:bold;\"> Approver Remarks</span>\r\n                    <ul>\r\n                        <li>{{ remark.remark }}</li>\r\n                    </ul>\r\n                {% endif %}\r\n            {%- endfor -%}\r\n         {% endif%}\r\n    </div>\r\n    <br/>\r\n    <div class=\"div\"> \r\n        {% if doc.copied|length > 0 %}\r\n            <span style=\"font-weight:bold;\"> Copy To:</span>\r\n            {%- for copy in doc.copied -%}\r\n                <ul >\r\n                    <li>{{ copy.employee_name }}</li>\r\n                </ul>\r\n            {%- endfor -%}\r\n        {% endif %}\r\n        \r\n        \r\n\r\n    </div>\r\n    <br/>\r\n    \r\n    \r\n    </div>\r\n</div>\r\n<!-- Page Footer -->\r\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"position:absolute;bottom:0;margin-left:80px\">\r\n    <div style=\"font-family: 'Courier New', Courier, monospace; font-size: 12px;text-align: center;\">\r\n        <p>This print is system generated and should be considered VALID without appropriate seal and/or signature.</p>\r\n    </div>\r\n    {% if not no_letterhead and footer %}\r\n        <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n        </div>\r\n    {% endif %}\r\n\r\n    <p class=\"text-center small page-number visible-pdf\">\r\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n    </p>\r\n</div>",
