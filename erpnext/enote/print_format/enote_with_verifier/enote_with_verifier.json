 "html": "<div style=\"font-size: 13px\">\r\n    <!--Page Head-->\r\n    <div>\r\n        <div id=\"header-html\" class=\"hidden-pdf\">\r\n            {%- if letter_head and not no_letterhead -%}\r\n                <div class=\"letter-head\">\r\n                    {{ letter_head }}\r\n                </div>\r\n            {%- endif -%}\r\n        </div>\r\n    </div>\r\n    <!-- Main Page -->\r\n    \r\n    <div class=\"div\" style=\"margin-top: -35px; font-family:bold; background-color: red;\"> \r\n        <p style=\"float:left\">{{doc.enote_series}} </p>\r\n        <p style=\"float:right\">{{frappe.utils.get_datetime(doc.note_date).strftime(\"%e-%B-%Y\",)}}</p>\r\n        \r\n    </div>\r\n    \r\n    <br/>\r\n    \r\n    <div class=\"div\">\r\n       \r\n        <div>\r\n            <div style=\"float:left;\">\r\n                {% if doc.category==\"Notesheet\" %}\r\n                    <span>{{doc.category}}</span>\r\n                {% endif %}\r\n            </div>\r\n        </div><br>\r\n        <div class=\"content\">{{ doc.content}}</div>\r\n        <br>\r\n    </div>\r\n    \r\n    \r\n    \r\n    <!--<div class=\"div\"> -->\r\n         <!--{% if doc.workflow_state == \"Approved\" %}-->\r\n    <!--        {%- for remark in doc.remark -%}-->\r\n    <!--            {% if remark.action == 'Forward' and not remark.print_hide and remark.remark %}-->\r\n    <!--                <span style=\"font-weight:bold;\"> Verifier Remark</span>-->\r\n    <!--                <ul>-->\r\n    <!--                    <li>{{ remark.remark }}</li>-->\r\n    <!--                </ul>-->\r\n    <!--            {% endif %}-->\r\n                \r\n    <!--            {% if remark.action == 'Approve' and not remark.print_hide and remark.remark%}-->\r\n    <!--                <span style=\"font-weight:bold;\"> Approver Remarks</span>-->\r\n    <!--                <ul>-->\r\n    <!--                    <li>{{ remark.remark }}</li>-->\r\n    <!--                </ul>-->\r\n    <!--            {% endif %}-->\r\n    <!--        {%- endfor -%}-->\r\n         <!--{% endif%}-->\r\n    <!--</div>-->\r\n    \r\n    \r\n    \r\n    \r\n    {% set owner_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.owner}, \"scan_sign\") or \"\" %}\r\n    {% set modified_by_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.modified_by}, \"scan_sign\") or \"\" %}\r\n    \r\n    \r\n    \r\n\r\n        <div style=\"float:left\">\r\n            <p style=\"font-weight: bold;\"> Submitted By:</p>\r\n            \r\n            \r\n              {% if owner_scan_sign %}\r\n            <img src=\"{{ owner_scan_sign }}\" style=\"width: 100px;\">\r\n            {% endif %}\r\n            \r\n            <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Apply\"}, \"employee_name\")}}</p>\r\n            <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Apply\"}, \"designation\")}})</p>\r\n        </div>\r\n<br>\r\n\r\n{% set modified_by_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.modified_by}, \"scan_sign\") or \"\" %}\r\n\r\n     <table class=\"table table-condensed\" id=\"table\" style=\"margin-top: 15px;width:100%; font-size: 12px;\">\r\n\r\n\r\n\t\t\t<th>Verifier Name</th>\r\n\t\t\t<th>Verifier EID</th>\r\n\t\t\t<th>Verifier Designation</th>\r\n\t\t\t<th>Signature</th>\r\n\t\t\t{%- for row in doc.reviewers -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td style=\"width:3%\">{{ row.employee }}</td>\r\n\t\t\t\t<td style=\"width:30%\">{{ row.employee_name }}</td>\r\n\t\t\t\t\r\n\t\t\t\t<td style=\"width:50%\">{{ row.designation }} </td>\r\n\t\t\t    <td style=\"width:17%\">\r\n\t\t\t\t    <img src=\"{{ row.signature }}\" >\r\n\t\t\t\t</td>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t</tr>\r\n\t\t\t{%- endfor -%}\r\n\r\n           \r\n           \r\n       </table>\r\n       \r\n        <!-- <div>-->\r\n        <!--    <p style=\"font-weight: bold;\"> Verifier:</p>-->\r\n            \r\n           \r\n            \r\n            \r\n        <!--      {% if reviewer_scan_sign %}-->\r\n        <!--    <img src=\"{{ reviewer_scan_sign }}\" style=\"width: 100px;\">-->\r\n        <!--    {% endif %}-->\r\n            \r\n            \r\n            \r\n            \r\n        <!--    <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Review\"}, \"employee_name\")}}</p>-->\r\n        <!--    <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Review\"}, \"designation\")}})</p>-->\r\n        <!--</div>-->\r\n        \r\n        \r\n        \r\n    </div\r\n    <br>\r\n    <br>\r\n    <div>\r\n        \r\n        <div style=\"float:right\">\r\n            <p style=\"font-weight: bold;\"> Approved By:</p>\r\n            \r\n              {% if modified_by_scan_sign %}\r\n            <img src=\"{{ modified_by_scan_sign }}\" style=\"width: 100px;\">\r\n            {% endif %}\r\n            <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Approve\"}, \"employee_name\")}}</p>\r\n            <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Approve\"}, \"designation\")}})</p>\r\n            \r\n        </div>\r\n        \r\n    </div>\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    <br/>\r\n    <div class=\"div\"> \r\n        {% if doc.copied|length > 0 %}\r\n            <span style=\"font-weight:bold;\"> Copy To:</span>\r\n            {%- for copy in doc.copied -%}\r\n                <ul >\r\n                    <li>{{ copy.employee_name }}</li>\r\n                </ul>\r\n            {%- endfor -%}\r\n        {% endif %}\r\n        \r\n        \r\n\r\n    </div>\r\n    <br/>\r\n    \r\n    \r\n    </div>\r\n</div>\r\n<!-- Page Footer -->\r\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"position:absolute;bottom:0;margin-left:80px\">\r\n    <div style=\"font-family: 'Courier New', Courier, monospace; font-size: 12px;text-align: center;\">\r\n        <p>This print is system generated and should be considered VALID.</p>\r\n    </div>\r\n    {% if not no_letterhead and footer %}\r\n        <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n        </div>\r\n    {% endif %}\r\n\r\n    <p class=\"text-center small page-number visible-pdf\">\r\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n    </p>\r\n</div>",
