 "css": ".div {  \n    margin-left:30px;\n    margin-right:30px;\n}\n\n.content{\n    text-align: justify;\n}\n\n\n\n#table {\n   font-family: Arial, Helvetica, sans-serif;\n   border-collapse: collapse;\n   width: 100%;\n    \n}\n\n#table td, #table th {\n  border: 1px solid #bfbdbd;\n  padding: 2px;\n  padding-top: 2px;\n  padding-bottom: 2px;\n}\n\n#table tr:nth-child(even){background-color: #f2f2f2;}\n\n#table tr:hover {background-color: #ddd;}\n\n#table th {\n  padding-top: 2px;\n  padding-bottom: 2px;\n  text-align: left;\n  background-color: #dce4e6;\n  color: black;\n}\n  \n",
