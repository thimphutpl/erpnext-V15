 "html": "<div style=\"font-size: 13px\">\n    <!--Page Head-->\n    <div>\n        <div id=\"header-html\" class=\"hidden-pdf\">\n            {%- if letter_head and not no_letterhead -%}\n                <div class=\"letter-head\">\n                    {{ letter_head }}\n                </div>\n            {%- endif -%}\n        </div>\n    </div>\n    <!-- Main Page -->\n    \n    <div class=\"div\" style=\"margin-top: -35px; font-family:bold; background-color: red;\"> \n        <p style=\"float:left\">{{doc.enote_format}} </p>\n        <p style=\"float:right\">{{frappe.utils.get_datetime(doc.note_date).strftime(\"%e-%B-%Y\",)}}</p>\n        \n    </div>\n    \n    <br/>\n    \n    <div class=\"div\">\n       \n        <div>\n            <div style=\"float:left;\">\n                {% if doc.category==\"Notesheet\" %}\n                    <span>{{doc.category}}</span>\n                {% endif %}\n            </div>\n        </div><br>\n        <div class=\"content\">{{ doc.content}}</div>\n        <br>\n    </div>\n    \n    \n    \n    <!--<div class=\"div\"> -->\n         <!--{% if doc.workflow_state == \"Approved\" %}-->\n    <!--        {%- for remark in doc.remark -%}-->\n    <!--            {% if remark.action == 'Forward' and not remark.print_hide and remark.remark %}-->\n    <!--                <span style=\"font-weight:bold;\"> Verifier Remark</span>-->\n    <!--                <ul>-->\n    <!--                    <li>{{ remark.remark }}</li>-->\n    <!--                </ul>-->\n    <!--            {% endif %}-->\n                \n    <!--            {% if remark.action == 'Approve' and not remark.print_hide and remark.remark%}-->\n    <!--                <span style=\"font-weight:bold;\"> Approver Remarks</span>-->\n    <!--                <ul>-->\n    <!--                    <li>{{ remark.remark }}</li>-->\n    <!--                </ul>-->\n    <!--            {% endif %}-->\n    <!--        {%- endfor -%}-->\n         <!--{% endif%}-->\n    <!--</div>-->\n    \n    \n    \n    \n    {% set owner_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.owner}, \"scan_sign\") or \"\" %}\n    {% set modified_by_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.modified_by}, \"scan_sign\") or \"\" %}\n    \n    \n    \n\n        <div style=\"float:left\">\n            <p style=\"font-weight: bold;\"> Submitted By:</p>\n            \n            \n              {% if owner_scan_sign %}\n            <img src=\"{{ owner_scan_sign }}\" style=\"width: 100px;\">\n            {% endif %}\n            \n            <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Apply\"}, \"employee_name\")}}</p>\n            <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Apply\"}, \"designation\")}})</p>\n        </div>\n<br>\n\n{% set modified_by_scan_sign = frappe.db.get_value(\"Employee\", {\"user_id\": doc.modified_by}, \"scan_sign\") or \"\" %}\n\n   <!--  <table class=\"table table-condensed\" id=\"table\" style=\"margin-top: 15px;width:100%; font-size: 12px;\">-->\n\n\n\t\t\t<!--<th>Verifier Name</th>-->\n\t\t\t<!--<th>Verifier EID</th>-->\n\t\t\t<!--<th>Verifier Designation</th>-->\n\t\t\t<!--<th>Signature</th>-->\n\t\t\t<!--{%- for row in doc.reviewers -%}-->\n\t\t\t<!--<tr>-->\n\t\t\t<!--\t<td style=\"width:3%\">{{ row.employee }}</td>-->\n\t\t\t<!--\t<td style=\"width:30%\">{{ row.employee_name }}</td>-->\n\t\t\t\t\n\t\t\t<!--\t<td style=\"width:50%\">{{ row.designation }} </td>-->\n\t\t\t<!--    <td style=\"width:17%\">-->\n\t\t\t<!--\t    <img src=\"{{ row.signature }}\" >-->\n\t\t\t<!--\t</td>-->\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\n\t\t\t<!--</tr>-->\n\t\t\t<!--{%- endfor -%}-->\n\n           \n           \n   <!--    </table>-->\n       \n        <!-- <div>-->\n        <!--    <p style=\"font-weight: bold;\"> Verifier:</p>-->\n            \n           \n            \n            \n        <!--      {% if reviewer_scan_sign %}-->\n        <!--    <img src=\"{{ reviewer_scan_sign }}\" style=\"width: 100px;\">-->\n        <!--    {% endif %}-->\n            \n            \n            \n            \n        <!--    <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Review\"}, \"employee_name\")}}</p>-->\n        <!--    <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Review\"}, \"designation\")}})</p>-->\n        <!--</div>-->\n        \n        \n        \n    </div\n    <br>\n    <br>\n    <div>\n        \n        <div style=\"float:right\">\n            <p style=\"font-weight: bold;\"> Approved By:</p>\n            \n              {% if modified_by_scan_sign %}\n            <img src=\"{{ modified_by_scan_sign }}\" style=\"width: 100px;\">\n            {% endif %}\n            <p style=\"font-style: bold;\"> {{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Approve\"}, \"employee_name\")}}</p>\n            <p style=\"font-style: bold;\">({{ frappe.db.get_value(\"Note Remark\",{\"parent\":doc.name, \"action\":\"Approve\"}, \"designation\")}})</p>\n            \n        </div>\n        \n    </div>\n    \n    \n    \n    \n    \n    <br/>\n    <div class=\"div\"> \n        {% if doc.copied|length > 0 %}\n            <span style=\"font-weight:bold;\"> Copy To:</span>\n            {%- for copy in doc.copied -%}\n                <ul >\n                    <li>{{ copy.employee_name }}</li>\n                </ul>\n            {%- endfor -%}\n        {% endif %}\n        \n        \n\n    </div>\n    <br/>\n    \n    \n    </div>\n</div>\n<!-- Page Footer -->\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"position:absolute;bottom:0;margin-left:80px\">\n    <div style=\"font-family: 'Courier New', Courier, monospace; font-size: 12px;text-align: center;\">\n        <p>This print is system generated and should be considered VALID.</p>\n    </div>\n    {% if not no_letterhead and footer %}\n        <div class=\"letter-head-footer\">\n        {{ footer }}\n        </div>\n    {% endif %}\n\n    <p class=\"text-center small page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </p>\n</div>",
