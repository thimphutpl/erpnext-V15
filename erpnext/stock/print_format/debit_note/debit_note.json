 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=yes\">\r\n    <title>Purchase Receipt | Debit Note</title>\r\n    <style>\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        body {\r\n            background: #e2e8f0;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            padding: 2rem 1rem;\r\n            font-family: 'Inter', 'times new roman', 'Roboto', system-ui, -apple-system, sans-serif;\r\n        }\r\n\r\n        /* Receipt container \u2013 optimized for print and screen */\r\n        .receipt {\r\n            max-width: 1100px;\r\n            width: 100%;\r\n            background: white;\r\n            border-radius: 20px;\r\n            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.15);\r\n            overflow: hidden;\r\n            transition: all 0.2s;\r\n        }\r\n\r\n        /* inner content with generous padding */\r\n        .receipt-inner {\r\n            padding: 2rem 2rem 2rem 2rem;\r\n        }\r\n\r\n        /* PRINT STYLES \u2013 clean, crisp, no background waste */\r\n        @media print {\r\n            body {\r\n                background: white;\r\n                padding: 0;\r\n                margin: 0;\r\n            }\r\n            .receipt {\r\n                box-shadow: none;\r\n                border-radius: 0;\r\n                max-width: 100%;\r\n            }\r\n            .receipt-inner {\r\n                padding: 0.4in;\r\n            }\r\n            .balance-due-highlight {\r\n                background: #f3f4f6 !important;\r\n                border: 1px solid #d1d5db !important;\r\n                print-color-adjust: exact;\r\n                -webkit-print-color-adjust: exact;\r\n            }\r\n            .status-badge {\r\n                background: #fef3c7 !important;\r\n                print-color-adjust: exact;\r\n                -webkit-print-color-adjust: exact;\r\n            }\r\n            .footer-note {\r\n                border-top: 1px solid #ccc;\r\n            }\r\n            button, .no-print {\r\n                display: none;\r\n            }\r\n        }\r\n\r\n        /* Typography */\r\n        h1 {\r\n            font-size: 1.9rem;\r\n            font-weight: 700;\r\n            letter-spacing: -0.3px;\r\n            color: #111827;\r\n            margin: 0;\r\n        }\r\n        h2 {\r\n            font-size: 1.3rem;\r\n            font-weight: 600;\r\n            color: #1f2937;\r\n            border-left: 4px solid #f59e0b;\r\n            padding-left: 0.75rem;\r\n            margin: 0 0 0.75rem 0;\r\n        }\r\n        .company-name {\r\n            font-size: 1.6rem;\r\n            font-weight: 800;\r\n            color: #0f3b2c;\r\n            letter-spacing: -0.2px;\r\n        }\r\n        .doc-sub {\r\n            color: #4b5563;\r\n            font-size: 0.85rem;\r\n            font-weight: 500;\r\n        }\r\n        .text-muted {\r\n            color: #4b5563;\r\n        }\r\n        .fw-semibold {\r\n            font-weight: 600;\r\n        }\r\n\r\n        /* layout grids */\r\n        .header-grid {\r\n            display: flex;\r\n            flex-wrap: wrap;\r\n            justify-content: space-between;\r\n            gap: 1.5rem;\r\n            margin-bottom: 2rem;\r\n            border-bottom: 2px dashed #e5e7eb;\r\n            padding-bottom: 1.5rem;\r\n        }\r\n        .seller-info {\r\n            flex: 1.4;\r\n        }\r\n        .doc-info {\r\n            flex: 1;\r\n            background: #f9fafb;\r\n            padding: 1rem 1.2rem;\r\n            border-radius: 18px;\r\n            text-align: right;\r\n        }\r\n        .bill-row {\r\n            display: flex;\r\n            flex-wrap: wrap;\r\n            gap: 2rem;\r\n            margin-bottom: 2rem;\r\n            justify-content: space-between;\r\n        }\r\n        .bill-to {\r\n            flex: 1.2;\r\n            background: #ffffff;\r\n            border: 1px solid #eef2ff;\r\n            border-radius: 20px;\r\n            padding: 1rem 1.4rem;\r\n            box-shadow: 0 1px 2px rgba(0,0,0,0.02);\r\n        }\r\n        .ref-block {\r\n            flex: 0.9;\r\n            background: #fefce8;\r\n            border-radius: 20px;\r\n            padding: 1rem 1.4rem;\r\n            border: 1px solid #fef3c7;\r\n        }\r\n        .place-supply {\r\n            margin-top: 0.75rem;\r\n            font-size: 0.9rem;\r\n            background: #f1f5f9;\r\n            display: inline-block;\r\n            padding: 0.25rem 1rem;\r\n            border-radius: 30px;\r\n        }\r\n\r\n        /* table styles */\r\n        .items-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin: 1.5rem 0 1.8rem 0;\r\n            font-size: 0.9rem;\r\n        }\r\n        .items-table th {\r\n            background: #f1f5f9;\r\n            text-align: left;\r\n            padding: 12px 10px;\r\n            font-weight: 600;\r\n            color: #1e293b;\r\n            border-bottom: 2px solid #cbd5e1;\r\n        }\r\n        .items-table td {\r\n            padding: 12px 10px;\r\n            border-bottom: 1px solid #e2e8f0;\r\n            vertical-align: top;\r\n            color: #1f2937;\r\n        }\r\n        .items-table tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n        .text-right {\r\n            text-align: right;\r\n        }\r\n        .text-center {\r\n            text-align: center;\r\n        }\r\n\r\n        /* totals panel */\r\n        .totals-panel {\r\n            display: flex;\r\n            justify-content: flex-end;\r\n            margin: 1rem 0 1.5rem 0;\r\n        }\r\n        .totals-box {\r\n            width: 320px;\r\n            background: #fafcff;\r\n            border-radius: 18px;\r\n            padding: 1rem 1.5rem;\r\n            border: 1px solid #e2e8f0;\r\n        }\r\n        .total-row {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 0.5rem 0;\r\n            font-size: 0.95rem;\r\n            border-bottom: 1px solid #eef2ff;\r\n        }\r\n        .total-row.bold {\r\n            font-weight: 700;\r\n            font-size: 1.05rem;\r\n            border-bottom: none;\r\n            color: #0f3b2c;\r\n        }\r\n        .grand-total {\r\n            border-top: 2px solid #cbd5e1;\r\n            margin-top: 0.4rem;\r\n            padding-top: 0.7rem;\r\n            font-weight: 800;\r\n            font-size: 1.2rem;\r\n            color: #b45309;\r\n        }\r\n        .balance-due-highlight {\r\n            background: #fff7ed;\r\n            border-radius: 14px;\r\n            padding: 0.5rem 1rem;\r\n            margin-top: 0.5rem;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            font-weight: 800;\r\n            font-size: 1.1rem;\r\n            border: 1px solid #fed7aa;\r\n        }\r\n\r\n        /* top balance badge */\r\n        .balance-badge {\r\n            background: #fef2e8;\r\n            display: inline-block;\r\n            padding: 0.5rem 1.2rem;\r\n            border-radius: 40px;\r\n            margin-bottom: 1rem;\r\n        }\r\n        .amount-large {\r\n            font-size: 1.7rem;\r\n            font-weight: 800;\r\n            color: #b45309;\r\n            line-height: 1;\r\n        }\r\n        hr {\r\n            margin: 1rem 0;\r\n            border: 0;\r\n            border-top: 1px solid #e5e7eb;\r\n        }\r\n        .footer-note {\r\n            margin-top: 2rem;\r\n            text-align: center;\r\n            font-size: 0.7rem;\r\n            color: #6c757d;\r\n            border-top: 1px solid #eef2ff;\r\n            padding-top: 1rem;\r\n        }\r\n        .badge-status {\r\n            background: #fef3c7;\r\n            padding: 0.2rem 0.8rem;\r\n            border-radius: 50px;\r\n            font-size: 0.7rem;\r\n            font-weight: 600;\r\n            display: inline-block;\r\n        }\r\n        @media (max-width: 700px) {\r\n            .receipt-inner {\r\n                padding: 1.2rem;\r\n            }\r\n            .header-grid {\r\n                flex-direction: column;\r\n            }\r\n            .doc-info {\r\n                text-align: left;\r\n            }\r\n            .bill-row {\r\n                flex-direction: column;\r\n            }\r\n            .totals-panel {\r\n                justify-content: stretch;\r\n            }\r\n            .totals-box {\r\n                width: 100%;\r\n            }\r\n            .items-table th, .items-table td {\r\n                padding: 8px 6px;\r\n                font-size: 0.8rem;\r\n            }\r\n        }\r\n        .separator-dash {\r\n            border-bottom: 1px dashed #d4d4d8;\r\n            margin: 0.75rem 0;\r\n        }\r\n        .inline-icon {\r\n            font-weight: 600;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"receipt\">\r\n    <div class=\"receipt-inner\">\r\n        <!-- Main header: seller + document title & balance due at top right -->\r\n        <div class=\"header-grid\">\r\n            <div class=\"seller-info\">\r\n                <div class=\"company-name\">Zylker India</div>\r\n                <div class=\"doc-sub mt-1\" style=\"margin-top: 6px;\">44 Annasalai, Chennai 600002, India.</div>\r\n                <div class=\"doc-sub\" style=\"margin-top: 8px;\">\r\n                    GSTIN: 33GSPTN037IGIZD &nbsp;|&nbsp; PAN: 312456789<br>\r\n                    Phone: 98573829384\r\n                </div>\r\n            </div>\r\n            <div class=\"doc-info\">\r\n                <div class=\"balance-badge\">\r\n                    <span class=\"text-muted\" style=\"font-size: 0.8rem;\">BALANCE DUE</span><br>\r\n                    <span class=\"amount-large\">\u20b9103.00</span>\r\n                </div>\r\n                <div style=\"margin-top: 8px;\">\r\n                    <div><span class=\"fw-semibold\">Debit Note#</span> CDN-000004</div>\r\n                    <div><span class=\"fw-semibold\">Debit Note Date:</span> 05 Sep 2017</div>\r\n                    <div><span class=\"fw-semibold\">Terms:</span> Due on Receipt</div>\r\n                    <div><span class=\"fw-semibold\">Due Date:</span> 05 Sep 2017</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Bill To + Reference row (mirroring the image layout) -->\r\n        <div class=\"bill-row\">\r\n            <div class=\"bill-to\">\r\n                <h2>Bill To</h2>\r\n                <div><strong>Ambit Depots</strong></div>\r\n                <div>10 Thakur Street, Chennai 600450</div>\r\n                <div>Tamil Nadu, India.</div>\r\n                <div class=\"separator-dash\"></div>\r\n                <div><span class=\"fw-semibold\">GSTIN:</span> 33GSPKA037IGIFE</div>\r\n                <div><span class=\"fw-semibold\">Phone:</span> 982309583</div>\r\n                <div><span class=\"fw-semibold\">Circuit ID:</span> 57686533GSPKA037IGIFE</div>\r\n            </div>\r\n            <div class=\"ref-block\">\r\n                <div><span class=\"fw-semibold\">Reference Invoice#</span> PC106</div>\r\n                <div><span class=\"fw-semibold\">Reference Invoice Date:</span> 03 Aug 2017</div>\r\n                <div class=\"separator-dash\" style=\"margin: 12px 0;\"></div>\r\n                <div><span class=\"fw-semibold\">Place Of Supply:</span> \r\n                    <span class=\"place-supply\" style=\"background:transparent; padding-left:0;\">Tamil Nadu (33)</span>\r\n                </div>\r\n                <div style=\"margin-top: 12px;\">\r\n                    <span class=\"badge-status\">Document type: Pur