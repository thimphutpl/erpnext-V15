 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n    <style>\r\n        body {\r\n            font-size: 16px;\r\n        }\r\n        h5{\r\n            font-weight:bold;\r\n        }\r\n        .container-1, .container-2, .container-3 {\r\n            border: 3px solid #D4D4D4;\r\n            padding: 20px;\r\n            margin-top: 20px;\r\n        }\r\n        \r\n        .cv-field {\r\n            display: flex;\r\n            margin-bottom: 8px;\r\n        }\r\n        .field-label {\r\n            font-weight: bold;\r\n            min-width: 180px;\r\n        }\r\n        .field-value {\r\n            flex-grow: 1;\r\n        }\r\n      \r\n        .table-row {\r\n            display: flex;\r\n            padding: 8px 0;\r\n        }\r\n        .table-header {\r\n            font-weight: bold;\r\n        }\r\n        .table-cell {\r\n            flex: 1;\r\n            padding: 0 5px;\r\n        }\r\n    </style>\r\n<head>\r\n\t<div>\r\n        <div class=\"col-12 text-center letter-head\" style=\"font-size:24px;font-weight:500\">\r\n            Curriculum Vitae        \r\n        </div>\r\n    </div>\r\n</head>\r\n<body>\r\n    <div class=\"container-1\">\r\n        <img src=\"{{doc.image or ''}}\" style=\"width:150px; height:150px; float:right; margin-left:20px; margin-bottom:20px; border:3px solid #d4d4d4;\">        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">ID CARD NO. :</div>\r\n            <div class=\"field-value\">{{doc.passport_number or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">EMPLOYEE ID :</div>\r\n            <div class=\"field-value\">{{doc.name or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">FIRST NAME :</div>\r\n            <div class=\"field-value\">{{doc.first_name or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">MIDDLE NAME :</div>\r\n            <div class=\"field-value\">{{doc.middle_name or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">LAST NAME :</div>\r\n            <div class=\"field-value\">{{doc.last_name or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">TITLE :</div>\r\n            <div class=\"field-value\">{{doc.designation or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">DATE OF BIRTH :</div>\r\n            <div class=\"field-value\">{{doc.date_of_birth or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">POSITION CATEGORY :</div>\r\n            <div class=\"field-value\">{{doc.employee_group or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">GRADE :</div>\r\n            <div class=\"field-value\">{{doc.pms_group or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">DEPARTMENT NAME :</div>\r\n            <div class=\"field-value\">{{doc.department or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">DIVISION NAME :</div>\r\n            <div class=\"field-value\">{{doc.division or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">APPOINTMENT NO :</div>\r\n            <div class=\"field-value\">{{doc.old_emp_id or 'None'}}</div>\r\n        </div>\r\n        \r\n         <div class=\"cv-field\" style=\"display: flex; flex-wrap: wrap;\">\r\n            <div class=\"field-label\" style=\"min-width: 180px;\">APPOINTMENT DATE :</div>\r\n            <div class=\"field-value\" style=\"min-width: 150px;\">{{doc.date_of_joining_hms or 'None'}}</div>\r\n            <div class=\"field-label\" style=\"min-width: 120px; margin-left: 20px;\">JOINING DATE :</div>\r\n            <div class=\"field-value\">{{doc.date_of_joining or 'None'}}</div>\r\n        </div>\r\n                \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">E-MAIL :</div>\r\n            <div class=\"field-value\">{{doc.company_email or 'None'}}</div>\r\n        </div>\r\n        \r\n         <div class=\"cv-field\" style=\"display: flex; flex-wrap: wrap;\">\r\n            <div class=\"field-label\" style=\"min-width: 180px;\">PHONE NO :</div>\r\n            <div class=\"field-value\" style=\"min-width: 150px;\">{{doc.cell_number or 'None'}}</div>\r\n            <div class=\"field-label\" style=\"min-width: 120px; margin-left: 20px;\">MOBILE NO :</div>\r\n            <div class=\"field-value\">{{doc.cell_number or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">CONTACT ADDRESS :</div>\r\n            <div class=\"field-value\">{{doc.current_address or 'None'}}</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\" style=\"display: flex; flex-wrap: wrap;\">\r\n            <div class=\"field-label\" style=\"min-width: 180px;\">THRAM NO :</div>\r\n            <div class=\"field-value\" style=\"min-width: 150px;\">None</div>\r\n            <div class=\"field-label\" style=\"min-width: 120px; margin-left: 20px;\">HOUSE NO :</div>\r\n            <div class=\"field-value\">None</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\" style=\"display: flex; flex-wrap: wrap;\">\r\n            <div class=\"field-label\" style=\"min-width: 180px;\">VILLAGE :</div>\r\n            <div class=\"field-value\" style=\"min-width: 150px;\">{{doc.village or 'None'}}</div>\r\n            <div class=\"field-label\" style=\"min-width: 120px; margin-left: 20px;\">GEWOG :</div>\r\n            <div class=\"field-value\">{{doc.gewog or 'None'}}</div>\r\n        </div>\r\n        \r\n       <div class=\"cv-field\" style=\"display: flex; flex-wrap: wrap;\">\r\n            <div class=\"field-label\" style=\"min-width: 180px;\">DZONGKHAG :</div>\r\n            <div class=\"field-value\" style=\"min-width: 150px;\">{{doc.dzongkhag or 'None'}}</div>\r\n            <div class=\"field-label\" style=\"min-width: 120px; margin-left: 20px;\">COUNTRY :</div>\r\n            <div class=\"field-value\">Bhutan</div>\r\n        </div>\r\n        \r\n        <div class=\"cv-field\">\r\n            <div class=\"field-label\">REMARKS :</div>\r\n            <div class=\"field-value\">{{doc.bio or 'None'}}</div>\r\n        </div>\r\n    </div>\r\n    \r\n    <div class=\"container-2\">\r\n     <h5>  PROMOTION DETAILS </h5>\r\n        <div class=\"table-row table-header\">\r\n            <div class=\"table-cell\">DATE</div>\r\n            <div class=\"table-cell\">FROM TITLE</div>\r\n            <div class=\"table-cell\">TO TITLE</div>\r\n            <div class=\"table-cell\">FROM GRADE</div>\r\n            <div class=\"table-cell\">TO GRADE</div>\r\n        </div>\r\n        {% if doc.internal_work_history and doc.internal_work_history|length > 0 %}\r\n        {% for promotion in doc.internal_work_history %}\r\n        <div class=\"table-row\">\r\n            <div class=\"table-cell\">{{promotion.from_date or 'None'}}</div>\r\n            <div class=\"table-cell\">{{promotion.designation or 'None'}}</div>\r\n            <div class=\"table-cell\">{{promotion.designation or 'None'}}</div>\r\n            <div class=\"table-cell\">{{promotion.pms_group or 'None'}}</div>\r\n            <div class=\"table-cell\">{{promotion.pms_group or 'None'}}</div>\r\n        </div>\r\n        {% endfor %}\r\n        {% else %}\r\n        <div class=\"table-row\">\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n    <div class=\"container-3\">\r\n        <h5>  QUALIFICATION DETAILS</h5>\r\n        <div class=\"table-row table-header\">\r\n            <div class=\"table-cell\">FIELD</div>\r\n            <div class=\"table-cell\">INSTITUTE</div>\r\n            <div class=\"table-cell\">COUNTRY</div>\r\n            <div class=\"table-cell\">QUALIFICATION</div>\r\n        </div>\r\n      \r\n        {% if doc.education and doc.education|length > 0 %}\r\n        {% for edu in doc.education %}\r\n        <div class=\"table-row\">\r\n            <div class=\"table-cell\">{{edu.maj_opt_subj or 'None'}}</div>\r\n            <div class=\"table-cell\">{{edu.school_univ or 'None'}}</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">{{edu.qualification or 'None'}}</div>\r\n        </div>\r\n        {% endfor %}\r\n        {% else %}\r\n        <div class=\"table-row\">\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n    <div class=\"container-3\">\r\n        <h5> FAMILY DETAILS</h5>\r\n        <div class=\"table-row table-header\">\r\n            <div class=\"table-cell\">ID CARD NO</div>\r\n            <div class=\"table-cell\">NAME</div>\r\n            <div class=\"table-cell\">RELATION</div>\r\n            <div class=\"table-cell\">DATE OF BIRTH</div>\r\n            <div class=\"table-cell\">OCCUPATION</div>\r\n        </div>\r\n        {% if doc.nominee and doc.nominee|length > 0 %}\r\n        {% for family in doc.nominee %}\r\n        <div class=\"table-row\">\r\n            <div class=\"table-cell\">{{family.cid_number or 'None'}}</div>\r\n            <div class=\"table-cell\">{{family.nominee_name or 'None'}}</div>\r\n            <div class=\"table-cell\">{{family.relation or 'None'}}</div>\r\n            <div class=\"table-cell\">{{family.date_of_birth or 'None'}}</div>\r\n            <div class=\"table-cell\">{{family.occupation or 'None'}}</div>\r\n        </div>\r\n        {% endfor %}\r\n        {% else %}\r\n        <div class=\"table-row\">\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n            <div class=\"table-cell\">None</div>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n</body>\r\n</html>",
