 "html": "<div style=\"font-family: 'Times New Roman', Times, serif; text-align: center; border-bottom: 2px solid #FFD700; padding-bottom: 15px; margin-bottom: 20px;\">\r\n    <p style=\"font-size: 22px; font-weight: bold; color: #FF4D00; margin: 5px 0; letter-spacing: 1px;\">ROYAL GOVERNMENT OF BHUTAN</p>\r\n    <p style=\"font-size: 18px; font-weight: bold; color: #333; margin: 5px 0; letter-spacing: 0.5px;\">HIS MAJESTY'S SECRETARIAT</p>\r\n    <p style=\"font-size: 16px; color: #555; margin: 5px 0; font-style: italic;\">THIMPHU</p>\r\n</div>\r\n<main style=\"font-family: 'Times New Roman', Times, serif;\">\r\n    <div style=\"font-size:16px;font-weight:semi-bold;\">\r\n    <p>Date: {{ doc.posting_date }}</p><br>\r\n    <p>POL/HSD Recoupment statement for the period from {{ doc.posting_date }} to {{ doc.posting_date }} for Vehicle No {{ doc.equipment }}. Please release a cheque for <strong> {{ doc.total_amount }}/-</strong><br>({{doc.total_amounts}}) only in favour of M/s BOD, Thimphu on the account of POL/HSD recoupment for the said vehicle attached to.</p>\r\n</div>\r\n    \r\n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 30px; font-family: 'Times New Roman', Times, serif;\">\r\n        <thead>\r\n            <tr style=\"background-color: #FFD700; color: #333; font-weight: bold;\">\r\n                <th style=\"border: 1px solid #ddd; padding: 12px; text-align: center;\">SL #</th>\r\n                <th style=\"border: 1px solid #ddd; padding: 12px; text-align: center;\">Supply Memo No</th>\r\n                <th style=\"border: 1px solid #ddd; padding: 12px; text-align: center;width:100px\">Date</th>\r\n                <th style=\"border: 1px solid #ddd; padding: 12px; text-align: center;\">Description</th>\r\n                <th style=\"border: 1px solid #ddd; padding: 12px; text-align: center;\">Quantity/Liters</th>\r\n                <th style=\"border: 1px solid #ddd; padding: 12px; text-align: center;\">Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            \r\n            <tr style=\"font-weight: semi-bold; background-color: #f5f5f5;\">\r\n                <td style=\"border: 1px solid #ddd; padding: 10px; text-align: right;\">1</td>\r\n                <td style=\"border: 1px solid #ddd; padding: 10px; text-align: right;\">{{ doc.fuelbook }}</td>\r\n                <td style=\"border: 1px solid #ddd; padding: 10px; text-align: right;\">{{ doc.posting_date }}</td>\r\n                <td style=\"border: 1px solid #ddd; padding: 10px; text-align: right;\">{{ doc.item_name }}</td>\r\n                {% if doc and doc.items %}\r\n                    {% for item in doc.items %}\r\n                        <td style=\"border: 1px solid #ddd; padding: 10px; text-align: right;\">{{ item.qty}}</td>\r\n                        \r\n                    {% endfor %}\r\n                {% endif %}\r\n                <td style=\"border: 1px solid #ddd; padding: 10px; text-align: right;\">{{ doc.total_amount }}</td>\r\n                \r\n            </tr>\r\n        </tbody>\r\n    </table><br>\r\n    <div style=\"margin: 20px 0;font-size:16px\">\r\n    <div style=\"display: flex; justify-content: space-between; gap: 30px;\">\r\n        <!-- Left Column (Odd Numbers) -->\r\n        <div style=\"flex: 1;\">\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">1.</span>\r\n                <p style=\"margin: 0;\">Previous Km reading: {{doc.previous_km_reading}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">3.</span>\r\n                <p style=\"margin: 0;\">Total Km covered (1-2): {{doc.total_km_covered}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">5.</span>\r\n                <p style=\"margin: 0;\">Previous Tank Balance: {{doc.previous_tank_balance}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">7.</span>\r\n                <p style=\"margin: 0;\">Present Tank Balance: {{doc.present_tank_balance}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">9.</span>\r\n                <p style=\"margin: 0;\">Average Fuel consumption: {{doc.average_fuel_consumption_38}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">11.</span>\r\n                <p style=\"margin: 0;\">Date of last Pol/HSD recoupment made: {{doc.date_of_last_pol}}</p>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Right Column (Even Numbers) -->\r\n        <div style=\"flex: 1;\">\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">2.</span>\r\n                <p style=\"margin: 0;\">Current Km reading: {{doc.current_km_reading_2}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">4.</span>\r\n                <p style=\"margin: 0;\">Pol issued: {{doc.pol_issued}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">6.</span>\r\n                <p style=\"margin: 0;\">Total PoL Issued: {{doc.total_pol_issed}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">8.</span>\r\n                <p style=\"margin: 0;\">Total POL consumed (6-7): {{doc.total_pol_consumed}}</p>\r\n            </div>\r\n            <div style=\"margin-bottom: 15px; display: flex; align-items: center;\">\r\n                <span style=\"font-weight: bold; margin-right: 10px; width: 25px;\">10.</span>\r\n                <p style=\"margin: 0;\">Balance Amount as per the supply/PoL Book: {{doc.balance_amount_as_per_the_supplypol_book}}</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<p style=\"font-size:16px;font-weight:bold;\">Prepared/Submitted/Verified and Forward by:</p>\r\n</main>",
