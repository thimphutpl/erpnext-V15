 "html": "<div class=\"page-break\">\r\n\t<div id=\"header-html\" class=\"hidden-pdf\">\r\n\t\t{%- if letter_head and not no_letterhead -%}\r\n\t\t<div class=\"letter-head\">\r\n\t\t\t{{ letter_head }}\r\n\t\t</div>\r\n\t\t{%- endif -%}\r\n\t</div>\r\n\t\r\n\t<div id=\"main\" style=\"font-family: 'Times New Roman', Times, serif; text-align: left;\">\r\n\t\r\n        <div>\r\n              <table class=\"table1\" style=\"margin-top: 1px; text-align: left; font-size: small; width: 100%; font-family: 'Times New Roman', Times, serif;\">\r\n                  \r\n              <tr>\r\n                <td style=\"width: 50%\"><strong>Original invoice for client/ Receipent</strong></td>\r\n                <td style=\"width: 50%\"><strong>INVOICE</strong></td>\r\n              </tr>\r\n            </table>\r\n        </div>\r\n\t\t\r\n\t\t<div>\r\n              <table class=\"table1\" style=\"margin-top: 1px; text-align: left; font-size: small; width: 100%; font-family: 'Times New Roman', Times, serif;\">\r\n              \r\n              <tr>\r\n                <td style=\"width: 24%\"><strong>POS Profile</strong></td>\r\n                <td>{{ doc.pos_profile}}</td>\r\n                <td style=\"text-align: left\"><strong>Date:</strong></td>\r\n                <td>{{frappe.utils.formatdate(doc.posting_date)}}</td>\r\n              </tr>\r\n              <tr>\r\n                <td><strong>Customer:</strong></td>\r\n                <td>{{ doc.customer}}</td>\r\n                <td><strong>Invoice #:</strong></td>\r\n                <td>{{ doc.name}}</td>\r\n              </tr>\r\n            </table>\r\n        </div>\r\n\r\n\t\t<table class=\"table table-condensed\" id=\"table\" style=\"margin-top: 15px; width: 100%; font-size: 12px; font-family: 'Times New Roman', Times, serif; text-align: left;\">\r\n\r\n\t\t\t<td>Sl.No</td>\r\n\t\t\t<td>Code</td>\r\n\t\t\t<td>Name</td>\r\n\t\t\t<td>Unit</td>\r\n\t\t\t<td>Qty</td>\r\n\t\t\t<td>Rate</td>\r\n\t\t\t<td>Amount</td>\r\n\t\t\r\n\t\t\t{%- for row in doc.items -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td style=\"width:3%\">{{ row.idx }}</td>\r\n\t\t\t\t<td style=\"width:10%; text-align: left;\">{{ row.item_code }}</td>\r\n\t\t\t\t<td style=\"width:35%; text-align: left;\">{{ row.item_name }}\r\n\t\t\t\t\t<br /><i><small>({{frappe.db.get_value(\"Item\", {\"name\": row.item_code}, \"item_group\")}})</i>\r\n\t\t\t\t\t{%- if row.brand_name -%}\r\n\t\t\t\t\t<i style=\"font-size: x-small\"><br />{{ row.brand_name }}</i>\r\n\t\t\t\t\t{%- endif -%}\r\n\t\t\t\t\t{%- if row.model_name -%}\r\n\t\t\t\t\t<i style=\"font-size: x-small\"> <br /> {{ row.model_name }}</i>\r\n\t\t\t\t\t{%- endif -%}\r\n\t\t\t\t\t{%- if row.notes -%}\r\n\t\t\t\t\t<i style=\"font-size: x-small\"><br />({{ row.notes }})</i>\r\n\t\t\t\t\t{%- endif -%}</small>\r\n\t\t\t\t</td>\r\n\r\n\t\t\t\t<td style=\"widht:7%\">{{ row.uom }}</td>\r\n\t\t\t\t<td style=\"width:5%; text-align: left;\">{{ row.qty }}</td>\r\n\t\t\t\t<td style=\"width:15%; text-align: left;\">{{ frappe.format_value(row.rate, {\"fieldtype\":\"Currency\"})}}\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"width:15%; text-align: left;\">{{ frappe.format_value(row.amount, {\"fieldtype\":\"Currency\"})\r\n\t\t\t\t\t}}</td>\r\n\t\t\t</tr>\r\n\t\t\t{%- endfor -%}\r\n\r\n\t\t\t{%- if doc.discount -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"6\" style=\"text-align: left;\"><strong>Discount</strong>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t{{ frappe.format_value(doc.discount * -1, {\"fieldtype\":\"Currency\"}) }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t{%- endif -%}\r\n\t\t\t{%- if doc.freight_and_insurance_charges -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"6\" style=\"text-align: left;\"><strong>Freight and Insurance Charges</strong>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t{{ frappe.format_value(doc.freight_and_insurance_charges, {\"fieldtype\":\"Currency\"}) }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t{%- endif -%}\r\n\t\t\t{%- if doc.tax -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"6\" style=\"text-align: left;\"><strong>Taxes</strong>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t{{ frappe.format_value(doc.tax, {\"fieldtype\":\"Currency\"}) }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t{%- endif -%}\r\n\t\t\t{%- if doc.other_charges -%}\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"6\" style=\"text-align: left;\"><strong>Other Charges</strong>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t{{ frappe.format_value(doc.other_charges, {\"fieldtype\":\"Currency\"}) }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t{%- endif -%}\r\n\t\t\t\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"6\" style=\"text-align: left;\"><b>Discount</b>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t{{ frappe.format_value(doc.discount_amount, {\"fieldtype\":\"Currency\"}) }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\r\n\t\t\t<tr>\r\n\t\t\t\t<td colspan=\"6\" style=\"text-align: left;\"><b>Net Total</b>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t{{ frappe.format_value(doc.grand_total, {\"fieldtype\":\"Currency\"}) }}\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t</table>\r\n\t\t\r\n\t\t<div style=\"margin-top: 5px; text-align: left; font-size: small; font-family: 'Times New Roman', Times, serif;\">\r\n\t\t\t<strong>In Words: </strong> {{ (frappe.utils.money_in_words(doc.grand_total))}}\r\n\t\t</div>\r\n\t\t{%- if doc.remarks -%}\r\n\t\t\t<div style=\"margin-top: 5px; text-align: left; font-size: small; font-family: 'Times New Roman', Times, serif;\">\r\n\t\t\t<strong>Remarks: </strong> {{doc.remarks}}\r\n\t\t    </div>\r\n\t\t\t{%- endif -%}\r\n\t\t\r\n    \r\n    <tr style=\"background-color: #ffffff;\">\r\n            <td colspan=\"3\"  style=\"border: 1px solid #000; padding: 8px; text-align: left; font-weight: 500; vertical-align: top;font-size:14px;\">\r\n                <p><strong>GBCL Credit Policy 2023</strong></p>\r\n                <p>1. An Advance may be release as per the Agreement.</p> \r\n                <p>2. The customer shall be given 30 days from the date of the invoice to make the payment.</p>\r\n                <p>3. A penalty per month can be levied as per the Credit Policy 2023.</p>\r\n                <p>4. Kindly call or email to share the remittance copy</p>\r\n            </td>\r\n            <td style=\"border: 1px solid #000; padding: 8px; text-align: left; font-weight: 500; vertical-align: top;\">\r\n        </td>\r\n        <td style=\"border: 1px solid #000; padding: 8px; text-align: left; font-weight: 500; vertical-align: top;\">\r\n        </td>\r\n    </tr>\r\n    \r\n    <div style=\"margin-top: 2px; text-align: left; font-size: x-small; font-family: 'Times New Roman', Times, serif;\">\r\n        <table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-family: 'Times New Roman', Times, serif;\">\r\n            <tr style=\"background-color: #f2f2f2;\">\r\n                <th colspan=\"5\" style=\"text-align: left; font-size: 12px; padding: 8px;\">\r\n                    Beneficiary Bank Details\r\n                </th>\r\n            </tr>\r\n            \r\n            <tr>\r\n                <td style=\"font-weight:400; width: 50%; padding: 8px;font-size:14px;\">Bank Account Name</td>\r\n                <td colspan=\"4\" style=\"font-size:14px;font-weight:400; padding: 8px;\">Green Bhutan Corporation Limited</td>\r\n            </tr>\r\n            \r\n             <tr>\r\n                <td style=\"font-weight:400; width: 50%; padding: 8px;font-size:14px;\">Account Number</td>\r\n                <td colspan=\"4\" style=\"font-size:14px;font-weight:400; padding: 8px;\">200354156</td>\r\n            </tr>\r\n            \r\n            <tr>\r\n                <td style=\"font-size:14px;font-weight:400; padding: 8px;\">Bank Branch</td>\r\n                <!--<td colspan=\"2\" style=\"font-size:14px;font-weight:400; padding: 8px;\">Thimphu Corporate Branch</td>-->\r\n                <td colspan=\"4\" style=\"font-size:14px;font-weight:400; padding: 8px;\">Thimphu Main Branch</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"font-weight:400; width: 50%; padding: 8px;font-size:14px;\">TPN Number</td>\r\n                <td colspan=\"4\" style=\"font-size:14px;font-weight:400; padding: 8px;\">GAC00224</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n\r\n    <div style=\"margin-top: 20px; text-align: left; font-size: 14px; font-family: 'Times New Roman', Times, serif;\">\r\n        <p>Authorized Signatory</p>\r\n        <div style=\"height: 40px; margin: 10px 0; margin-top: 29px;\"></div>\r\n        <p></p>\r\n    </div>\r\n    </div>\r\n</div>",
