 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* Print Styles */\n    @media print {\n        .page-break {\n            page-break-before: always;\n        }\n        .no-break {\n            page-break-inside: avoid;\n        }\n        body {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n            margin: 0;\n            padding: 20px;\n        }\n    }\n\n    /* Main Container */\n    .invoice-container {\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        max-width: 1100px;\n        margin: 0 auto;\n        padding: 20px;\n        background: white;\n        border: 1px solid #ddd;\n    }\n\n    /* Header Section */\n    .header {\n        text-align: center;\n        margin-bottom: 30px;\n        border-bottom: 2px solid #333;\n        padding-bottom: 15px;\n    }\n\n    .company-name {\n        font-size: 24px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .company-details {\n        font-size: 12px;\n        color: #555;\n        margin-top: 5px;\n    }\n\n    .document-title {\n        font-size: 28px;\n        font-weight: bold;\n        margin: 10px 0;\n        letter-spacing: 5px;\n    }\n\n    /* Info Grid */\n    .info-grid {\n        display: flex;\n        flex-wrap: wrap;\n        margin-bottom: 30px;\n        border: 1px solid #ddd;\n    }\n\n    .info-box {\n        flex: 1;\n        padding: 12px;\n        border-right: 1px solid #ddd;\n    }\n\n    .info-box:last-child {\n        border-right: none;\n    }\n\n    .info-label {\n        font-weight: bold;\n        font-size: 11px;\n        color: #666;\n        text-transform: uppercase;\n        margin-bottom: 5px;\n    }\n\n    .info-value {\n        font-size: 13px;\n        font-weight: 500;\n    }\n\n    /* Customer Section */\n    .customer-section {\n        display: flex;\n        margin-bottom: 20px;\n        border: 1px solid #ddd;\n    }\n\n    .customer-box {\n        flex: 1;\n        padding: 15px;\n    }\n\n    .customer-box:first-child {\n        border-right: 1px solid #ddd;\n    }\n\n    .section-title {\n        font-weight: bold;\n        font-size: 14px;\n        margin-bottom: 10px;\n        background: #f5f5f5;\n        padding: 5px;\n        border-left: 3px solid #2c3e50;\n    }\n\n    /* Items Table */\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 20px 0;\n        font-size: 12px;\n    }\n\n    .items-table th {\n        background-color: #2c3e50;\n        color: white;\n        padding: 12px 8px;\n        text-align: left;\n        font-weight: bold;\n    }\n\n    .items-table td {\n        border: 1px solid #ddd;\n        padding: 10px 8px;\n        vertical-align: top;\n    }\n\n    .items-table tr:nth-child(even) {\n        background-color: #f9f9f9;\n    }\n\n    /* Totals Section */\n    .totals-section {\n        display: flex;\n        justify-content: flex-end;\n        margin-top: 20px;\n    }\n\n    .totals-table {\n        width: 350px;\n        border-collapse: collapse;\n    }\n\n    .totals-table td {\n        padding: 8px;\n        border: none;\n    }\n\n    .totals-table td:first-child {\n        font-weight: bold;\n    }\n\n    .totals-table td:last-child {\n        text-align: right;\n    }\n\n    .total-row {\n        font-size: 16px;\n        font-weight: bold;\n        border-top: 2px solid #333;\n    }\n\n    /* Amount in Words */\n    .amount-words {\n        margin: 20px 0;\n        padding: 10px;\n        background: #f9f9f9;\n        border-left: 4px solid #2c3e50;\n        font-size: 12px;\n    }\n\n    /* Footer */\n    .footer {\n        margin-top: 40px;\n        padding-top: 20px;\n        border-top: 1px solid #ddd;\n        font-size: 11px;\n        color: #666;\n        text-align: center;\n    }\n\n    /* Signature Section */\n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 40px;\n    }\n\n    .signature-box {\n        text-align: center;\n        width: 30%;\n    }\n\n    .signature-line {\n        border-top: 1px solid #333;\n        margin-top: 40px;\n        padding-top: 10px;\n        width: 100%;\n    }\n\n    /* Bank Details */\n    .bank-details {\n        margin-top: 20px;\n        padding: 10px;\n        background: #f5f5f5;\n        font-size: 11px;\n        border: 1px solid #ddd;\n    }\n\n    /* TDS Section */\n    .tds-note {\n        margin-top: 20px;\n        padding: 10px;\n        background: #fff3cd;\n        border-left: 4px solid #ffc107;\n        font-size: 11px;\n    }\n\n    /* Responsive */\n    @media (max-width: 768px) {\n        .info-grid, .customer-section {\n            flex-direction: column;\n        }\n        .info-box, .customer-box {\n            border-right: none;\n            border-bottom: 1px solid #ddd;\n        }\n        .totals-section {\n            justify-content: flex-start;\n        }\n    }\n\n    .text-right {\n        text-align: right;\n    }\n\n    .text-center {\n        text-align: center;\n    }\n\n    .bold {\n        font-weight: bold;\n    }\n</style>\n\n<div class=\"invoice-container\">\n    <!-- Header -->\n    <div class=\"header\">\n        <div class=\"company-name\">{{ doc.company or \"TATA Motors\" }}</div>\n        <div class=\"company-details\">\n            {{ doc.company_address or \"Corporate Office: Mumbai, India\" }}<br>\n            GSTIN: {{ doc.gstin or \"27AAACT1234A1Z\" }} | PAN: {{ doc.pan or \"AAACT1234A\" }}\n        </div>\n        <div class=\"document-title\">TAX INVOICE / CHALLAN</div>\n    </div>\n\n    <!-- Document Info Grid -->\n    <div class=\"info-grid\">\n        <div class=\"info-box\">\n            <div class=\"info-label\">Invoice No.</div>\n            <div class=\"info-value\">{{ doc.name or doc.invoice_no or \"PBSH0002/AT/25/00048\" }}</div>\n        </div>\n        <div class=\"info-box\">\n            <div class=\"info-label\">Invoice Date</div>\n            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.posting_date) or \"31-03-2025\" }}</div>\n        </div>\n        <div class=\"info-box\">\n            <div class=\"info-label\">Challan No.</div>\n            <div class=\"info-value\">{{ doc.challan_no or \"BLSH0002/AT/25/00103\" }}</div>\n        </div>\n        <div class=\"info-box\">\n            <div class=\"info-label\">Challan Date</div>\n            <div class=\"info-value\">{{ doc.challan_date or \"31-03-2025\" }}</div>\n        </div>\n    </div>\n\n    <div class=\"info-grid\">\n        <div class=\"info-box\">\n            <div class=\"info-label\">Customer Order No.</div>\n            <div class=\"info-value\">{{ doc.customer_order_no or \"JH0100214213\" }}</div>\n        </div>\n        <div class=\"info-box\">\n            <div class=\"info-label\">Customer Order Date</div>\n            <div class=\"info-value\">{{ doc.customer_order_date or \"31-03-2025\" }}</div>\n        </div>\n        <div class=\"info-box\">\n            <div class=\"info-label\">Order No.</div>\n            <div class=\"info-value\">{{ doc.order_no or \"BLSH0002/AT/25/00102\" }}</div>\n        </div>\n        <div class=\"info-box\">\n            <div class=\"info-label\">Order Date</div>\n            <div class=\"info-value\">{{ doc.order_date or \"31-03-2025\" }}</div>\n        </div>\n    </div>\n\n    <!-- Customer & Ship To -->\n    <div class=\"customer-section\">\n        <div class=\"customer-box\">\n            <div class=\"section-title\">Customer Details</div>\n            <div><strong>{{ doc.customer or \"VAURA BUILDERS PRIVATE LIMITED\" }}</strong></div>\n            <div>{{ doc.customer_address or \"Thimphu, Bhutan\" }}</div>\n            <div>GSTIN: {{ doc.customer_gstin or \"27AAACV1234A1Z\" }}</div>\n            <div>PAN: {{ doc.customer_pan or \"AAACV1234A\" }}</div>\n        </div>\n        <div class=\"customer-box\">\n            <div class=\"section-title\">Ship To</div>\n            <div><strong>{{ doc.shipping_address_name or \"VAURA BUILDERS PRIVATE LIMITED\" }}</strong></div>\n            <div>{{ doc.shipping_address or \"Thimphu, Bhutan\" }}</div>\n        </div>\n    </div>\n\n    <!-- Items Table -->\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 5%\">Sr. No.</th>\n                <th style=\"width: 10%\">Code</th>\n                <th style=\"width: 45%\">Description</th>\n                <th style=\"width: 8%\">Quantity</th>\n                <th style=\"width: 10%\">UOM</th>\n                <th style=\"width: 10%\">Rate ({{ doc.currency or \"Nu.\" }})</th>\n                <th style=\"width: 12%\">Amount ({{ doc.currency or \"Nu.\" }})</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set items = doc.items or [] %}\n            {% if items %}\n                {% for item in items %}\n                <tr>\n                    <td class=\"text-center\">{{ loop.index }}</td>\n                    <td>{{ item.item_code or item.code or \"TATA-SIGNA-2823\" }}</td>\n                    <td>\n                        <strong>{{ item.item_name or item.description or \"TATA SIGNA 2823.T BSVI\" }}</strong><br>\n                        {% if item.engine_no %}\n                            Engine No.: {{ item.engine_no }}<br>\n                        {% endif %}\n                        {% if item.chassis_no %}\n                            Chassis No.: {{ item.chassis_no }}\n                        {% endif %}\n                    </td>\n                    <td class=\"text-center\">{{ item.qty or 1 }}</td>\n                    <td class=\"text-center\">{{ item.uom or \"NOS\" }}</td>\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(item.rate, 2) if item.rate else \"2,973,247.62\" }}</td>\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(item.amount, 2) if item.amount else \"2,973,247.62\" }}</td>\n                </tr>\n                {% endfor %}\n            {% else %}\n                <tr>\n                    <td class=\"text-center\">1</td>\n                    <td>TATA-SIGNA-2823</td>\n                    <td>\n                        <strong>TATA SIGNA 2823.T BSVI</strong><br>\n                        Engine No.: 52864455154<br>\n                        Chassis No.: MAT797090S1R06737\n                    </td>\n                    <td class=\"text-center\">1</td>\n                    <td class=\"text-center\">NOS</td>\n                    <td class=\"text-right\">2,973,247.62</td>\n                    <td class=\"text-right\">2,973,247.62</td>\n                </tr>\n                <tr>\n                    <td class=\"text-center\">2</td>\n                    <td>TATA-VEHICLES</td>\n                    <td>\n                        <strong>BST TATA VEHICLES</strong><br>\n                        Engine No.: 52864455154<br>\n                        Chassis No.: MAT797090S1R06737\n                    </td>\n                    <td class=\"text-center\">1</td>\n                    <td class=\"text-center\">NOS</td>\n                    <td class=\"text-right\">36,662.38</td>\n                    <td class=\"text-right\">36,662.38</td>\n                </tr>\n            {% endif %}\n        </tbody>\n    </table>\n\n    <!-- Totals Section -->\n    <div class=\"totals-section\">\n        <table class=\"totals-table\">\n            <tr>\n                <td>Subtotal:</td>\n                <td>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.base_net_total or 3009909.96, 2) }}</td>\n            </tr>\n            {% if doc.discount_amount %}\n            <tr>\n                <td>Discount:</td>\n                <td>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.discount_amount, 2) }}</td>\n            </tr>\n            {% endif %}\n            <tr>\n                <td>CGST ({{ doc.cgst_rate or \"2.5\" }}%):</td>\n                <td>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.cgst_amount or 75247.75, 2) }}</td>\n            </tr>\n            <tr>\n                <td>SGST ({{ doc.sgst_rate or \"2.5\" }}%):</td>\n                <td>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.sgst_amount or 75247.75, 2) }}</td>\n            </tr>\n            <tr>\n                <td>IGST ({{ doc.igst_rate or \"0\" }}%):</td>\n                <td>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.igst_amount or 0, 2) }}</td>\n            </tr>\n            {% if doc.cess_amount %}\n            <tr>\n                <td>Cess:</td>\n                <td>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.cess_amount, 2) }}</td>\n            </tr>\n            {% endif %}\n            <tr class=\"total-row\">\n                <td><strong>Total Amount:</strong></td>\n                <td><strong>{{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.base_grand_total or 3159405.46, 2) }}</strong></td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Amount in Words -->\n    <div class=\"amount-words\">\n        <strong>Amount in Words:</strong> \n        {{ doc.in_words or \"Thirty One Lakh Fifty Nine Thousand Four Hundred Five and Forty Six Paise Only\" }}\n    </div>\n\n    <!-- TDS Section (if applicable) -->\n    {% if doc.tds_applicable %}\n    <div class=\"tds-note\">\n        <strong>TDS Information:</strong><br>\n        TDS Rate: {{ doc.tds_rate or \"2\" }}% on Contract Amount<br>\n        TDS Amount: {{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money(doc.tds_amount or 60198.19, 2) }}<br>\n        Net Payable after TDS: {{ doc.currency or \"Nu.\" }} {{ frappe.utils.fmt_money((doc.base_grand_total or 3159405.46) - (doc.tds_amount or 60198.19), 2) }}\n    </div>\n    {% endif %}\n\n    <!-- Bank Details -->\n    <div class=\"bank-details\">\n        <strong>Bank Details for Payment:</strong><br>\n        Bank Name: {{ doc.bank_name or \"State Bank of India\" }}<br>\n        Account Name: {{ doc.account_name or \"TATA Motors Limited\" }}<br>\n        Account No.: {{ doc.account_no or \"1234567890123456\" }}<br>\n        IFSC Code: {{ doc.ifsc_code or \"SBIN0001234\" }}<br>\n        GSTIN: {{ doc.gstin or \"27AAACT1234A1Z\" }}\n    </div>\n\n    <!-- Terms & Conditions -->\n    {% if doc.terms %}\n    <div class=\"bank-details\" style=\"background: #e8f4fd; margin-top: 10px;\">\n        <strong>Terms & Conditions:</strong><br>\n        {{ doc.terms }}\n    </div>\n    {% else %}\n    <div class=\"bank-details\" style=\"background: #e8f4fd; margin-top: 10px;\">\n        <strong>Terms & Conditions:</strong><br>\n        1. Delivery within 7 days from invoice date<br>\n        2. Warranty as per company policy<br>\n        3. TDS will be deducted as per applicable rates<br>\n        4. E&OE\n    </div>\n    {% endif %}\n\n    <!-- Signature Section -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div><strong>For {{ doc.company or \"TATA Motors\" }}</strong></div>\n            <div>(Authorized Signatory)</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div><strong>Receiver's Signature</strong></div>\n            <div>(With Company Seal)</div>\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"footer\">\n        <div>This is a computer generated invoice and does not require physical signature</div>\n        <div>For any queries, please contact: {{ doc.contact_email or \"support@tatamotors.com\" }} | {{ doc.contact_phone or \"1800-209-8282\" }}</div>\n    </div>\n</div>",
