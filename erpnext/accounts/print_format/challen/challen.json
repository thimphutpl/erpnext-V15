 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>STCBL Letter of Authenticity</title>\r\n\r\n<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 30mm 20mm 25mm 20mm;\r\n    }\r\n\r\n    body {\r\n        font-family: \"Times New Roman\", serif;\r\n        font-size: 13px;\r\n        line-height: 1.5;\r\n        color: #000;\r\n    }\r\n\r\n    .letterhead {\r\n        text-align: center;\r\n        border-bottom: 2px solid #000;\r\n        padding-bottom: 8px;\r\n    }\r\n\r\n    .letterhead h1 {\r\n        font-size: 20px;\r\n        margin: 0;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .letterhead p {\r\n        margin: 2px 0;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .top-bar {\r\n        margin-top: 10px;\r\n        display: flex;\r\n        justify-content: space-between;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .ref {\r\n        text-align: right;\r\n    }\r\n\r\n    .address {\r\n        margin-top: 20px;\r\n    }\r\n\r\n    .subject {\r\n        margin-top: 15px;\r\n        font-weight: bold;\r\n        text-decoration: underline;\r\n    }\r\n\r\n    .body-text {\r\n        margin-top: 10px;\r\n        text-align: justify;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 10px;\r\n    }\r\n\r\n    table, th, td {\r\n        border: 1px solid #000;\r\n    }\r\n\r\n    th {\r\n        background: #f2f2f2;\r\n        text-align: center;\r\n    }\r\n\r\n    td {\r\n        padding: 6px;\r\n    }\r\n\r\n    .section-title {\r\n        margin-top: 15px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .footer {\r\n        margin-top: 40px;\r\n    }\r\n\r\n    .signature-section {\r\n        margin-top: 60px;\r\n        display: flex;\r\n        justify-content: space-between;\r\n    }\r\n\r\n    .signature-box {\r\n        text-align: center;\r\n        width: 40%;\r\n    }\r\n\r\n    .signature-line {\r\n        margin-top: 50px;\r\n        border-top: 1px solid #000;\r\n        padding-top: 5px;\r\n    }\r\n\r\n    .note {\r\n        margin-top: 20px;\r\n        font-size: 11px;\r\n    }\r\n\r\n</style>\r\n</head>\r\n\r\n<body>\r\n\r\n<!-- LETTERHEAD -->\r\n<div class=\"letterhead\">\r\n    <h1>STATE TRADING CORPORATION OF BHUTAN LTD.</h1>\r\n    <p>An ISO 9001:2015 QMS Certified Company</p>\r\n    <p>Head Office: Thimphu, Bhutan | www.stcb.bt</p>\r\n</div>\r\n\r\n<!-- TOP INFO -->\r\n<div class=\"top-bar\">\r\n    <div><strong>Ref No:</strong> STCBL/VEH/AUTH/2026</div>\r\n    <div class=\"ref\">\r\n        <strong>TPN:</strong> SAC00022<br>\r\n        <strong>Date:</strong> 01-04-2026\r\n    </div>\r\n</div>\r\n\r\n<!-- ADDRESS -->\r\n<div class=\"address\">\r\n    To,<br>\r\n    The Regional Transport Officer<br>\r\n    Bhutan Construction and Transport Authority (BCTA)<br>\r\n    Thimphu / Phuentsholing / Gelephu / Samdrup Jongkhar\r\n</div>\r\n\r\n<!-- SUBJECT -->\r\n<div class=\"subject\">\r\n    Subject: Letter of Authenticity of Toyota Vehicle\r\n</div>\r\n\r\n<!-- BODY -->\r\n<div class=\"body-text\">\r\n    Dear Sir/Madam,<br><br>\r\n\r\n    This is to certify that the following Toyota vehicle has been sold by \r\n    State Trading Corporation of Bhutan Ltd. through its authorized dealership. \r\n    The details of the customer and the vehicle are provided below for your \r\n    verification and necessary action.\r\n</div>\r\n\r\n<!-- CUSTOMER DETAILS -->\r\n<div class=\"section-title\">1. Customer Details</div>\r\n<table>\r\n    <tr><th width=\"5%\">Sl</th><th width=\"35%\">Particular</th><th>Details</th></tr>\r\n    <tr><td>1</td><td>Name</td><td>{{customer_name}}</td></tr>\r\n    <tr><td>2</td><td>CID No.</td><td>{{cid_no}}</td></tr>\r\n    <tr><td>3</td><td>Village</td><td>{{village}}</td></tr>\r\n    <tr><td>4</td><td>Gewog</td><td>{{gewog}}</td></tr>\r\n    <tr><td>5</td><td>Dzongkhag</td><td>{{dzongkhag}}</td></tr>\r\n    <tr><td>6</td><td>Present Address</td><td>{{present_address}}</td></tr>\r\n</table>\r\n\r\n<!-- VEHICLE DETAILS -->\r\n<div class=\"section-title\">2. Vehicle Details</div>\r\n<table>\r\n    <tr><th width=\"5%\">Sl</th><th width=\"35%\">Particular</th><th>Details</th></tr>\r\n    <tr><td>1</td><td>Make</td><td>TOYOTA</td></tr>\r\n    <tr><td>2</td><td>Model</td><td>{{model}}</td></tr>\r\n    <tr><td>3</td><td>Model Year</td><td>{{model_year}}</td></tr>\r\n    <tr><td>4</td><td>Engine No.</td><td>{{engine_no}}</td></tr>\r\n    <tr><td>5</td><td>Chassis No.</td><td>{{chassis_no}}</td></tr>\r\n    <tr><td>6</td><td>Bill No.</td><td>{{bill_no}}</td></tr>\r\n    <tr><td>7</td><td>Challan No.</td><td>{{challan_no}}</td></tr>\r\n    <tr><td>8</td><td>Color</td><td>{{color}}</td></tr>\r\n    <tr><td>9</td><td>BTN No.</td><td>{{btn_no}}</td></tr>\r\n    <tr><td>10</td><td>Engine Capacity</td><td>{{cc}} CC</td></tr>\r\n    <tr><td>11</td><td>Gross Weight</td><td>{{gross_weight}} KG</td></tr>\r\n    <tr><td>12</td><td>Seating Capacity</td><td>{{seating}}</td></tr>\r\n    <tr><td>13</td><td>Loading Capacity</td><td>{{loading}}</td></tr>\r\n    <tr><td>14</td><td>Fuel Type</td><td>{{fuel_type}}</td></tr>\r\n    <tr><td>15</td><td>Transmission</td><td>{{transmission}}</td></tr>\r\n    <tr><td>16</td><td>Vehicle Price</td><td>Nu. {{vehicle_price}}</td></tr>\r\n</table>\r\n\r\n<!-- FOOTER TEXT -->\r\n<div class=\"footer\">\r\n    This certificate is issued upon request of the customer for registration and \r\n    verification purposes with the Bhutan Construction and Transport Authority.\r\n</div>\r\n\r\n<!-- SIGNATURE -->\r\n<div class=\"signature-section\">\r\n\r\n    <div class=\"signature-box\">\r\n        <div class=\"signature-line\">Customer Name & Signature</div>\r\n    </div>\r\n\r\n    <div class=\"signature-box\">\r\n        <div class=\"signature-line\">\r\n            Authorized Signatory<br>\r\n            For State Trading Corporation of Bhutan Ltd.\r\n        </div>\r\n    </div>\r\n\r\n</div>\r\n\r\n<!-- NOTE -->\r\n<div class=\"note\">\r\n    <strong>Note:</strong> This is a system-generated document and does not require a seal \r\n    unless specified otherwise.\r\n</div>\r\n\r\n</body>\r\n</html>",
