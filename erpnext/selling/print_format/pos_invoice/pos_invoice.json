      <div style=\"flex: 2; text-align: right;\">-->\r\n<!--            {% if doc.flags.show_inclusive_tax_in_print %}-->\r\n<!--                {{ _(\"Total Excl. Tax\") }}-->\r\n<!--            {% else %}-->\r\n<!--                {{ _(\"Total\") }}-->\r\n<!--            {% endif %}-->\r\n<!--        </div>-->\r\n<!--        <div style=\"flex: 1; text-align: right;\">-->\r\n<!--            {{ doc.get_formatted(\"net_total\" if doc.flags.show_inclusive_tax_in_print else \"total\", doc) }}-->\r\n<!--        </div>-->\r\n<!--    </div>-->\r\n\r\n<!--    {%- for row in doc.taxes -%}-->\r\n<!--        {%- if not row.included_in_print_rate or doc.flags.show_inclusive_tax_in_print -%}-->\r\n<!--        <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">-->\r\n<!--            <div style=\"flex: 2; text-align: right;\">-->\r\n<!--                {% if '%' in row.description %} {{ row.description }} {% else %} {{ row.description }}@{{ row.rate }}% {% endif %}-->\r\n<!--            </div>-->\r\n<!--            <div style=\"flex: 1; text-align: right;\">-->\r\n<!--                {{ row.get_formatted(\"tax_amount\", doc) }}-->\r\n<!--            </div>-->\r\n<!--        </div>-->\r\n<!--        {%- endif -%}-->\r\n<!--    {%- endfor -%}-->\r\n\r\n<!--    {%- if doc.discount_amount -%}-->\r\n<!--    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">-->\r\n<!--        <div style=\"flex: 2; text-align: right;\">{{ _(\"Discount\") }}</div>-->\r\n<!--        <div style=\"flex: 1; text-align: right;\">{{ doc.get_formatted(\"discount_amount\") }}</div>-->\r\n<!--    </div>-->\r\n<!--    {%- endif -%}-->\r\n\r\n<!--    <div style=\"display: flex; justify-content: space-between; padding: 2px 0; font-weight: bold;\">-->\r\n<!--        <div style=\"flex: 2; text-align: right;\">{{ _(\"Grand Total\") }}</div>-->\r\n<!--        <div style=\"flex: 1; text-align: right;\">{{ doc.get_formatted(\"grand_total\") }}</div>-->\r\n<!--    </div>-->\r\n\r\n<!--    {%- for row in doc.payments -%}-->\r\n<!--    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">-->\r\n<!--        <div style=\"flex: 2; text-align: right;\">{{ row.mode_of_payment }}</div>-->\r\n<!--        <div style=\"flex: 1; text-align: right;\">{{ row.get_formatted(\"amount\", doc) }}</div>-->\r\n<!--    </div>-->\r\n<!--    {%- endfor -%}-->\r\n\r\n<!--    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">-->\r\n<!--        <div style=\"flex: 2; text-align: right;\">{{ _(\"Paid Amount\") }}</div>-->\r\n<!--        <div style=\"flex: 1; text-align: right;\">{{ doc.get_formatted(\"paid_amount\") }}</div>-->\r\n<!--    </div>-->\r\n\r\n<!--    {%- if doc.change_amount -%}-->\r\n<!--    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">-->\r\n<!--        <div style=\"flex: 2; text-align: right;\">{{ _(\"Change Amount\") }}</div>-->\r\n<!--        <div style=\"flex: 1; text-align: right;\">{{ doc.get_formatted(\"change_amount\") }}</div>-->\r\n<!--    </div>-->\r\n<!--    {%- endif -%}-->\r\n<!--</div>-->\r\n\r\n<!--<hr>-->\r\n<!--<p>{{ doc.terms or \"\" }}</p>-->\r\n\r\n<!--<div class=\"footer-fixed\">-->\r\n<!--    <p class=\"text-center\">{{ _(\"Thank you, please visit again.\") }}</p>-->\r\n<!--    <div class=\"footer-line\"></div>-->\r\n<!--        <p class=\"text-center\">-->\r\n<!--    This print is system generated and should be considered VALID only with appropriate seal and/or signature.<br>-->\r\n<!--    </p>-->\r\n<!--</div>-->\r\n\r\n<p class=\"text-center\" style=\"margin-bottom: 1rem\">\r\n    {{ doc.company }}<br>\r\n    <b>{{ doc.select_print_heading or _(\"Invoice\") }}</b><br>\r\n</p>\r\n\r\n<p style=\"font-size: 11px; margin: 0; line-height: 1.2; text-align: center;\">\r\n    Receipt No: {{ doc.name }}, Customer: {{ doc.customer_name }}<br>\r\n    Date: {{ doc.get_formatted(\"posting_date\") }} | Time: {{ doc.get_formatted(\"posting_time\") }}\r\n</p>\r\n\r\n<!-- Items List -->\r\n<div style=\"margin-top: 15px; font-size: 10px;font-family: Arial, sans-serif\">\r\n    <!-- Header -->\r\n<div style=\"display: flex; font-weight: bold; border-bottom: 1px solid #000; padding: 5px 0;\">\r\n    <div style=\"flex: 4; font-size: 9px;\">Item</div>\r\n    <div style=\"flex: 1; text-align: center; font-size: 9px;\">Rate (Nu.)</div>\r\n    <div style=\"flex: 1; text-align: center; font-size: 9px;\">Qty</div>\r\n    <div style=\"flex: 1; text-align: center; font-size: 9px;\">Amt (Nu.)</div>\r\n</div>\r\n    <!-- Items -->\r\n    {%- for item in doc.items -%}\r\n    <div style=\"display: flex; padding: 5px 0; border-bottom: 1px dashed #ccc;\">\r\n        <div style=\"flex: 4;\">\r\n            ({{ item.item_code }}) \r\n            {%- if item.item_name != item.item_code -%} {{ item.item_name }} {%- endif -%}\r\n            {%- if item.serial_no -%}<br><b>{{ _(\"SR.No\") }}:</b> {{ item.serial_no | replace(\"\\n\", \", \") }} {%- endif -%}\r\n        </div>\r\n        <div style=\"flex: 1; text-align: center;\">{{ item.rate }}</div>\r\n        <div style=\"flex: 1; text-align: center;\">{{ item.qty }}</div>\r\n        <div style=\"flex: 1; text-align: right;\">{{ item.amount }}</div>\r\n    </div>\r\n    {%- endfor -%}\r\n</div>\r\n\r\n<!-- Totals -->\r\n<div style=\"margin-top: 15px; font-size: 10px;\">\r\n    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n        <div style=\"flex: 4; text-align: right;\">\r\n            {% if doc.flags.show_inclusive_tax_in_print %}\r\n                {{ _(\"Total Excl. Tax\") }}\r\n            {% else %}\r\n                {{ _(\"Total\") }}\r\n            {% endif %}\r\n        </div>\r\n        <div style=\"flex: 3; text-align: right;\">\r\n            {{ doc.get_formatted(\"net_total\" if doc.flags.show_inclusive_tax_in_print else \"total\", doc) }}\r\n        </div>\r\n    </div>\r\n\r\n    {%- for row in doc.taxes -%}\r\n        {%- if not row.included_in_print_rate or doc.flags.show_inclusive_tax_in_print -%}\r\n        <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n            <div style=\"flex: 4; text-align: right;\">\r\n                {% if '%' in row.description %} {{ row.description }} {% else %} {{ row.description }}@{{ row.rate }}% {% endif %}\r\n            </div>\r\n            <div style=\"flex: 3; text-align: right;\">\r\n                {{ row.get_formatted(\"tax_amount\", doc) }}\r\n            </div>\r\n        </div>\r\n        {%- endif -%}\r\n    {%- endfor -%}\r\n\r\n    {%- if doc.discount_amount -%}\r\n    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n        <div style=\"flex: 4; text-align: right;\">{{ _(\"Discount\") }}</div>\r\n        <div style=\"flex: 3; text-align: right;\">{{ doc.get_formatted(\"discount_amount\") }}</div>\r\n    </div>\r\n    {%- endif -%}\r\n\r\n    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n        <div style=\"flex: 4; text-align: right;\">{{ _(\"Grand Total\") }}</div>\r\n        <div style=\"flex: 3; text-align: right;\">{{ doc.get_formatted(\"grand_total\") }}</div>\r\n    </div>\r\n\r\n    {%- for row in doc.payments -%}\r\n    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n        <div style=\"flex: 4; text-align: right;\">{{ row.mode_of_payment }}</div>\r\n        <div style=\"flex: 3; text-align: right;\">{{ row.get_formatted(\"amount\", doc) }}</div>\r\n    </div>\r\n    {%- endfor -%}\r\n\r\n    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n        <div style=\"flex: 4; text-align: right;\">{{ _(\"Paid Amount\") }}</div>\r\n        <div style=\"flex: 3; text-align: right;\">{{ doc.get_formatted(\"paid_amount\") }}</div>\r\n    </div>\r\n\r\n    {%- if doc.change_amount -%}\r\n    <div style=\"display: flex; justify-content: space-between; padding: 2px 0;\">\r\n        <div style=\"flex: 4; text-align: right;\">{{ _(\"Change Amount\") }}</div>\r\n        <div style=\"flex: 3; text-align: right;\">{{ doc.get_formatted(\"change_amount\") }}</div>\r\n    </div>\r\n    {%- endif -%}\r\n</div>\r\n\r\n<hr>\r\n<p>{{ doc.terms or \"\" }}</p>\r\n\r\n<div class=\"footer-fixed\">\r\n    <p class=\"text-center\">{{ _(\"Thank you, please visit again.\") }}</p>\r\n    <div class=\"footer-line\"></div>\r\n    <p class=\"text-center\">\r\n        This print is system generated and should be considered VALID only with appropriate seal and/or signature.<br>\r\n    </p>\r\n</div>",
